    between(2017,2027,Year),
    atom_concat("maintained ",Year,Event),
    (
        (
            double_equal(Year, 2017),
            Start_day=20170916
        )
    ;
        (
            \+ double_equal(Year, 2017),
            first_day_year(Year,Start_day)
        )
    ),
    last_day_year(Year,End_day).
